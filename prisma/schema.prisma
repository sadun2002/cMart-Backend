// ============================================================
// cMart Platform — Prisma Schema
// Company name is stored in src/common/constants.ts
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum UserRole {
  STORE_OWNER
  EMPLOYEE
  CUSTOMER
}

enum EmployeePosition {
  CASHIER
  MANAGER
  SUPERVISOR
  STAFF
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
}

enum PaymentMethod {
  CASH
  CARD
  PAYHERE_QR
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum DeliveryType {
  PICKUP
  DELIVERY
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum ThemeType {
  FREE
  PREMIUM
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ============================================================
// SUPER ADMIN
// ============================================================

model SuperAdmin {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String    // bcrypt hashed
  name      String
  role      AdminRole @default(ADMIN)
  avatar    String?
  active    Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  themes    Theme[]
  tickets   SupportTicket[]
}

// ============================================================
// THEMES (Uploaded by Super Admin)
// ============================================================

model Theme {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?   @db.Text
  previewUrl  String?   // Preview screenshot URL (Supabase Storage)
  zipUrl      String?   // Theme ZIP URL (Supabase Storage)
  price       Decimal   @default(0) @db.Decimal(10, 2) // 0 = free
  type        ThemeType @default(FREE)
  isActive    Boolean   @default(true)
  tags        String[]
  version     String    @default("1.0.0")

  uploadedById Int
  uploadedBy   SuperAdmin @relation(fields: [uploadedById], references: [id])

  purchases   ThemePurchase[]
  tenants     TenantTheme[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ============================================================
// TENANTS (Stores)
// ============================================================

model Tenant {
  id            Int       @id @default(autoincrement())
  businessName  String
  subdomain     String    @unique // e.g. "johnsstore"
  customDomain  String?   @unique // e.g. "www.johnsstore.lk" (Enterprise only)
  plan          Plan      @default(FREE)
  active        Boolean   @default(true)
  suspended     Boolean   @default(false)
  suspendedAt   DateTime?
  suspendReason String?
  trialEndsAt   DateTime?
  logoUrl       String?
  bannerUrl     String?

  ownerId   Int    @unique
  owner     User   @relation("TenantOwner", fields: [ownerId], references: [id])
  users     User[] @relation("TenantUsers")

  products     Product[]
  categories   Category[]
  sales        Sale[]
  customers    Customer[]
  onlineOrders OnlineOrder[]
  employees    Employee[]
  attendance   Attendance[]
  suppliers    Supplier[]

  subscription   Subscription?
  settings       TenantSettings?
  theme          TenantTheme?
  themePurchases ThemePurchase[]
  supportTickets SupportTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subdomain])
  @@index([customDomain])
  @@index([plan])
  @@index([active])
}

model TenantSettings {
  id              Int     @id @default(autoincrement())
  tenantId        Int     @unique
  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Localization
  currency        String  @default("LKR")
  timezone        String  @default("Asia/Colombo")
  language        String  @default("en") // "en" | "si"

  // Tax
  taxEnabled      Boolean @default(false)
  taxRate         Decimal @default(0) @db.Decimal(5, 2) // e.g. 18.00 for 18%
  taxName         String  @default("VAT")

  // Receipt
  receiptHeader   String? @db.Text
  receiptFooter   String? @db.Text
  receiptShowLogo Boolean @default(true)
  thermalEnabled  Boolean @default(false)

  // Inventory
  lowStockAlert   Boolean @default(true)
  lowStockThreshold Int   @default(10)

  // Online Store
  storeDescription String? @db.Text
  aboutPage        String? @db.Text
  contactPage      String? @db.Text
  termsPage        String? @db.Text
  privacyPage      String? @db.Text
  facebookUrl      String?
  instagramUrl     String?
  whatsappNumber   String?

  // Payment
  payhereEnabled   Boolean @default(false)
  payhereMerchantId String?
  payhereSecret    String?
  cashEnabled      Boolean @default(true)
  cardEnabled      Boolean @default(true)

  // Shipping
  freeShippingAbove Decimal? @db.Decimal(10, 2)
  defaultShippingFee Decimal @default(0) @db.Decimal(10, 2)
  deliveryEnabled  Boolean   @default(true)
  pickupEnabled    Boolean   @default(true)
  pickupAddress    String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantTheme {
  id              Int     @id @default(autoincrement())
  tenantId        Int     @unique
  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  themeId         Int
  theme           Theme   @relation(fields: [themeId], references: [id])

  // Customizations (colors, fonts, etc.)
  customizations  Json    @default("{}")
  // Example: { primaryColor: "#1E40AF", fontFamily: "Inter", heroImage: "url", logoUrl: "url" }

  appliedAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ThemePurchase {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  themeId    Int
  theme      Theme    @relation(fields: [themeId], references: [id])
  pricePaid  Decimal  @db.Decimal(10, 2)
  payhereRef String?

  purchasedAt DateTime @default(now())

  @@unique([tenantId, themeId])
}

// ============================================================
// USERS
// ============================================================

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String   // bcrypt hashed
  name     String
  phone    String?
  avatar   String?
  role     UserRole

  tenantId    Int?
  tenant      Tenant? @relation("TenantUsers", fields: [tenantId], references: [id])
  ownedTenant Tenant? @relation("TenantOwner")

  employee    Employee?
  sales       Sale[]
  attendance  Attendance[]
  onlineOrders OnlineOrder[]

  active        Boolean   @default(true)
  emailVerified Boolean   @default(false)
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([role])
  @@index([email])
}

// ============================================================
// EMPLOYEES
// ============================================================

model Employee {
  id           Int     @id @default(autoincrement())
  userId       Int     @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId     Int
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  employeeCode String
  position     EmployeePosition @default(CASHIER)
  salary       Decimal? @db.Decimal(10, 2)
  joinDate     DateTime @default(now())

  // Granular permissions JSON
  // { canProcessSales, canViewProducts, canAddProducts, canEditProducts,
  //   canDeleteProducts, canViewCustomers, canAddCustomers,
  //   canViewReports, canViewAllSales, canManageInventory }
  permissions  Json     @default("{}")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@index([employeeCode])
}

// ============================================================
// ATTENDANCE
// ============================================================

model Attendance {
  id          Int              @id @default(autoincrement())
  userId      Int
  user        User             @relation(fields: [userId], references: [id])
  tenantId    Int
  tenant      Tenant           @relation(fields: [tenantId], references: [id])

  date        DateTime         @db.Date
  checkIn     DateTime?
  checkOut    DateTime?
  hoursWorked Float?
  status      AttendanceStatus @default(PRESENT)
  notes       String?

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@index([tenantId, date])
}

// ============================================================
// CATEGORIES
// ============================================================

model Category {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  name        String
  slug        String
  description String?
  image       String?
  sortOrder   Int      @default(0)

  parentId    Int?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  products    Product[]

  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
}

// ============================================================
// PRODUCTS
// ============================================================

model Product {
  id          Int     @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant  @relation(fields: [tenantId], references: [id])

  name        String
  slug        String?
  description String?  @db.Text
  barcode     String?
  sku         String?

  price       Decimal  @db.Decimal(10, 2)
  cost        Decimal? @db.Decimal(10, 2)
  comparePrice Decimal? @db.Decimal(10, 2)

  // Inventory
  stock       Int      @default(0)
  minStock    Int      @default(10)
  trackStock  Boolean  @default(true)
  unit        String   @default("pcs") // pcs, kg, litre, etc.

  // E-commerce
  showOnWebsite Boolean  @default(false)
  featured      Boolean  @default(false)
  publishedAt   DateTime?

  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  tags        String[]

  saleItems        SaleItem[]
  onlineOrderItems OnlineOrderItem[]

  // SEO
  metaTitle       String?
  metaDescription String?

  // Shipping weight/dimensions
  weight  Float?
  length  Float?
  width   Float?
  height  Float?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@unique([tenantId, barcode])
  @@index([tenantId, showOnWebsite])
  @@index([tenantId, featured])
  @@index([tenantId, categoryId])
  @@index([tenantId, stock])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int     @default(0)

  @@index([productId])
}

// ============================================================
// SUPPLIERS
// ============================================================

model Supplier {
  id            Int    @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant @relation(fields: [tenantId], references: [id])

  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String? @db.Text
  city          String?
  notes         String? @db.Text

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ============================================================
// CUSTOMERS (in-store CRM)
// ============================================================

model Customer {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name    String
  phone   String?
  email   String?
  address String? @db.Text
  city    String?
  notes   String?

  totalSpent  Decimal @default(0) @db.Decimal(10, 2)
  totalOrders Int     @default(0)
  points      Int     @default(0)

  sales        Sale[]
  onlineOrders OnlineOrder[]

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([tenantId, email])
}

// ============================================================
// SALES (POS)
// ============================================================

model Sale {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  invoiceNo String

  subtotal  Decimal @db.Decimal(10, 2)
  tax       Decimal @default(0) @db.Decimal(10, 2)
  discount  Decimal @default(0) @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(COMPLETED)
  cashReceived  Decimal?      @db.Decimal(10, 2)
  changeGiven   Decimal?      @db.Decimal(10, 2)

  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id])
  userId     Int
  user       User      @relation(fields: [userId], references: [id])

  items  SaleItem[]
  notes  String?    @db.Text

  createdAt DateTime @default(now())

  @@unique([tenantId, invoiceNo])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, userId])
  @@index([tenantId, customerId])
}

model SaleItem {
  id          Int     @id @default(autoincrement())
  saleId      Int
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product @relation(fields: [productId], references: [id])
  productName String  // snapshot at time of sale
  quantity    Int
  price       Decimal @db.Decimal(10, 2) // unit price at time of sale
  cost        Decimal @default(0) @db.Decimal(10, 2) // cost at time of sale
  discount    Decimal @default(0) @db.Decimal(10, 2)
  subtotal    Decimal @db.Decimal(10, 2)
}

// ============================================================
// ONLINE ORDERS (E-commerce)
// ============================================================

model OnlineOrder {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  orderNumber String @unique

  // Customer info (guest or registered)
  customerId     Int?
  customer       Customer? @relation(fields: [customerId], references: [id])
  userId         Int?
  user           User?     @relation(fields: [userId], references: [id])
  customerName   String
  customerEmail  String
  customerPhone  String

  // Shipping / Delivery
  deliveryType    DeliveryType @default(DELIVERY)
  shippingAddress String?      @db.Text
  city            String?

  subtotal Decimal @db.Decimal(10, 2)
  tax      Decimal @default(0) @db.Decimal(10, 2)
  shipping Decimal @default(0) @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(PAYHERE_QR)
  paymentStatus PaymentStatus @default(PENDING)
  payhereRef    String?

  notes          String? @db.Text
  trackingNumber String?

  items OnlineOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([customerEmail])
}

model OnlineOrderItem {
  id          Int         @id @default(autoincrement())
  orderId     Int
  order       OnlineOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product     @relation(fields: [productId], references: [id])
  productName String      // snapshot
  quantity    Int
  price       Decimal     @db.Decimal(10, 2)
  subtotal    Decimal     @db.Decimal(10, 2)

  @@index([orderId])
}

// ============================================================
// SUBSCRIPTIONS
// ============================================================

model Subscription {
  id       Int    @id @default(autoincrement())
  tenantId Int    @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  plan            Plan               @default(FREE)
  status          SubscriptionStatus @default(TRIAL)
  startDate       DateTime           @default(now())
  trialEndDate    DateTime?
  nextBillingDate DateTime?
  endDate         DateTime?

  amountLKR   Decimal @default(0) @db.Decimal(10, 2)
  payhereSubId String? // PayHere subscription ID

  payments SubscriptionPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubscriptionPayment {
  id             Int          @id @default(autoincrement())
  subscriptionId Int
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])

  amountLKR  Decimal       @db.Decimal(10, 2)
  status     PaymentStatus @default(PENDING)
  payhereRef String?
  paidAt     DateTime?
  dueDate    DateTime

  createdAt DateTime @default(now())

  @@index([subscriptionId])
  @@index([status])
  @@index([dueDate])
}

// ============================================================
// SUPPORT TICKETS
// ============================================================

model SupportTicket {
  id       Int    @id @default(autoincrement())
  tenantId Int?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  subject    String
  message    String   @db.Text
  email      String
  name       String
  status     SupportTicketStatus @default(OPEN)

  assignedToId Int?
  assignedTo   SuperAdmin? @relation(fields: [assignedToId], references: [id])

  replies SupportTicketReply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([tenantId])
}

model SupportTicketReply {
  id       Int          @id @default(autoincrement())
  ticketId Int
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  message   String   @db.Text
  fromAdmin Boolean  @default(false) // true = admin reply, false = tenant reply
  senderName String

  createdAt DateTime @default(now())
}
