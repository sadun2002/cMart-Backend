# ============================================================
# cMart Backend — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# Server
PORT=3001
NODE_ENV=development

# ─── Database (Supabase PostgreSQL) ─────────────────────────
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_REFRESH_SECRET="your-refresh-secret-change-this"

# ─── Frontend URL ─────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"

# ─── Supabase Storage ─────────────────────────────────────────
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"
SUPABASE_BUCKET_PRODUCTS="product-images"
SUPABASE_BUCKET_THEMES="themes"
SUPABASE_BUCKET_LOGOS="logos"

# ─── Upstash Redis ─────────────────────────────────────────────
UPSTASH_REDIS_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_TOKEN="your-upstash-token"

# ─── Resend (Email) ────────────────────────────────────────────
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="noreply@cmart.lk"

# ─── PayHere.lk ────────────────────────────────────────────────
PAYHERE_MERCHANT_ID="your-payhere-merchant-id"
PAYHERE_SECRET="your-payhere-secret"
PAYHERE_MODE="sandbox"  # sandbox | live

# ─── Sentry ────────────────────────────────────────────────────
SENTRY_DSN="https://your@sentry.io/project"

# ─── Platform Config ───────────────────────────────────────────
PLATFORM_NAME="cMart"
PLATFORM_URL="https://cmart.lk"
PLATFORM_SUBDOMAIN_BASE="cmart.lk"
